# Copy to .env on the lab machine (never commit the real one).
# Homepage substitutes {{HOMEPAGE_VAR_*}} placeholders in config/services.yaml.
# A widget whose key is still blank just shows an error tile — fill these in as you go.

# Jellyfin → Dashboard → API Keys → +
HOMEPAGE_VAR_JELLYFIN_KEY=
# AdGuard Home admin login (from the phase 15 setup wizard)
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASSWORD=
# Paperless → Profile (top right) → API Auth Token
HOMEPAGE_VAR_PAPERLESS_TOKEN=
